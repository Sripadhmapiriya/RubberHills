# ==============================================================
# RUBBER HILLS KINDERGARTEN - ENVIRONMENT VARIABLES
# ==============================================================
# Copy this file to .env for local development.
# In production, set these environment variables in the Vercel Project Dashboard.
# NEVER commit real secret passwords to Git or share in public channels.

# 1. Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rubberhillskindergarten@gmail.com
# IMPORTANT: Generate a fresh 16-character Gmail App Password from Google Account > Security > App Passwords.
# Revoke any previously exposed app passwords immediately.
SMTP_PASS=your-fresh-16-digit-app-password

# 2. Recipient Email for Admission Inquiries
CONTACT_RECEIVER_EMAIL=rubberhillskindergarten@gmail.com

# 3. Optional: Persistent Rate Limiting (Upstash Redis or Vercel KV for Serverless)
# Configure in Vercel to activate persistent sliding-window rate limiting across all serverless lambda instances.
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# 4. Optional: CAPTCHA Provider (Cloudflare Turnstile or Google reCAPTCHA)
# Configure in Vercel to activate automated human verification on enquiry submissions.
# CAPTCHA_SECRET_KEY=your-captcha-secret-key
# VITE_CAPTCHA_SITE_KEY=your-captcha-site-key
